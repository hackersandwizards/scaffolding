{
  "model": "opus",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  },
  "advisorModel": "claude-fable-5-2",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.githooks/session-start\""
          }
        ]
      }
    ]
  },
  "claudeMdExcludes": [
    "/Users/*/.claude/rules/**",
    "/home/*/.claude/rules/**"
  ]
}
