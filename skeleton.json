{
  "same": [
    ".editorconfig",
    ".npmrc",
    "bunfig.toml",
    ".githooks/pre-commit",
    ".githooks/commit-msg",
    ".githooks/pre-push",
    ".githooks/post-merge",
    ".githooks/post-checkout",
    "scripts/repo/only-bun.cjs"
  ],
  "owned": [".github/workflows/pages.yml"],
  "present": [
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "AGENTS.md",
    ".gitignore",
    ".prettierignore",
    "package.json",
    "bun.lock",
    "tsconfig.json",
    ".claude/settings.json",
    ".mcp.json",
    ".codex/config.toml",
    "docs/agent-work"
  ],
  "absent": [
    "eslint.config.mjs",
    "eslint.config.cjs",
    ".eslintrc",
    ".eslintrc.json",
    ".eslintrc.js",
    ".prettierrc",
    ".prettierrc.js",
    ".prettierrc.mjs",
    "prettier.config.mjs",
    "vitest.config.mts",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml"
  ],
  "symlinks": {
    ".agents/skills": "../.claude/skills"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100
  },
  "package": {
    "type": "module",
    "engines.npm": "please-use-bun",
    "scripts": ["check", "check:staged"]
  },
  "hooksPath": ".githooks",
  "private": {
    "absent": [".githooks/commit-msg"],
    "same": [".githooks/pre-push"]
  },
  "catalog": {
    "scripts": ["dev", "catalog", "build"],
    "configs": ["astro.config.ts", "astro.config.mjs"],
    "preset": "@hackersandwizards/scaffolding/catalog"
  }
}
