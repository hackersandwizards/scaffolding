<meta name="fx-head" content="repository" />
<!-- A repository's head that declares a layer, which the shell's ground still sorts below. -->
<style is:inline>
  @layer base;
</style>
<link rel="icon" href="/assets/logo.svg" />
<script is:inline>
  // A repository's head attribute on <html> and its page script.
  document.documentElement.dataset.fxHead = "repository";
  addEventListener("DOMContentLoaded", () => (document.body.dataset.fxRan = location.pathname));
</script>
