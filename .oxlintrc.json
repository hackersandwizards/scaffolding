{
  "extends": ["./config/oxlint.json"],
  "plugins": ["typescript"],
  "env": {
    "browser": true,
    "node": true,
    "bun": true
  },
  "options": {
    "typeAware": true
  },
  "settings": {
    "scaffolding": {
      "duplicates": {
        "template/**": "The repository skeleton ships verbatim copies for consumers.",
        "template-catalog/**": "The catalog skeleton ships verbatim copies for consumers."
      }
    }
  },
  "overrides": [
    {
      "files": ["lib/**", "config/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+bin/",
                "message": "Keep command entry points in bin. Put reusable code in lib or config."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    "coverage/**",
    "**/dist/**",
    "**/.astro/**",
    "/.claude/**",
    "/.agents/**",
    "/.githooks/**",
    "/template/*",
    "!/template/.githooks/",
    "!/template/.githooks/**",
    "/template-catalog/**"
  ]
}
