{
  "name": "@hackersandwizards/scaffolding",
  "version": "5.14.1",
  "description": "Repository skeleton, gate commands, shared configs and the catalog shell: scaffold, scaffolding check, check-structure, check-confidential, check-staged, check-lock, and the catalog preset.",
  "keywords": [
    "astro-component"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "scaffold": "bin/scaffold.ts",
    "check-structure": "bin/check-structure.ts",
    "check-confidential": "bin/check-confidential.ts",
    "check-staged": "bin/check-staged.ts",
    "check-lock": "bin/check-lock.ts",
    "chrome-mcp": "bin/chrome-mcp.ts",
    "scaffolding": "bin/scaffolding.ts"
  },
  "exports": {
    "./eslint": "./config/eslint.js",
    "./eslint/astro": "./config/eslint-astro.js",
    "./tsconfig/bun.json": "./config/tsconfig.bun.json",
    "./tsconfig/astro.json": "./config/tsconfig.astro.json",
    "./prettier": "./config/prettier.js",
    "./chrome": "./lib/chrome.ts",
    "./serve": "./lib/serve.ts",
    "./catalog": "./catalog/index.ts",
    "./catalog/*": "./catalog/*",
    "./stylelint": "./config/stylelint.js"
  },
  "files": [
    "bin",
    "lib",
    "template",
    "template-catalog",
    "skeleton.json",
    "config",
    "catalog"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "packageManager": "bun@1.4.4",
  "peerDependencies": {
    "typescript": ">=5 <6.1",
    "eslint": ">=10",
    "prettier": ">=3",
    "eslint-plugin-astro": ">=1",
    "astro": ">=7",
    "astrobook": ">=0.13",
    "stylelint": ">=16"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "astrobook": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "check": "bun --no-env-file bin/scaffolding.ts check",
    "check:staged": "bun --no-env-file bin/check-staged.ts",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "check-confidential": "bun --no-env-file bin/check-confidential.ts",
    "check-lock": "bun --no-env-file bin/check-lock.ts",
    "chrome-mcp": "bun --no-env-file bin/chrome-mcp.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "astro": "7.4.7",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "scaffolding": {
    "allow": [
      {
        "check": "coupling",
        "path": "skeleton.json",
        "reason": "its one relative path is the .agents/skills symlink target, resolved from .agents/, inside the repository"
      },
      {
        "check": "structure",
        "path": ".github/workflows/pages.yml",
        "reason": "here it is the reusable workflow that the owned caller file of every other repository names"
      },
      {
        "check": "coupling",
        "path": "test/checks.test.ts",
        "reason": "planted cases the coupling tests feed to the check"
      },
      {
        "check": "unique-names",
        "path": ".claude/skills/engineering/*",
        "reason": "the home hub's sync copies the engineering skill's stand-alone check-staged.ts, an older form of this package's bin/check-staged.ts, into every repository; the hub owns it"
      }
    ],
    "check": [],
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout ${SCAFFOLDING_TEST_TIMEOUT_MS:-5000}",
    "skip": {
      "catalog": "no surface: the package ships the catalog shell and has no catalog of its own",
      "styles": "brand is not installed here, so its token file is not there to read; the shell's CSS reads brand's names by rule",
      "admin": "the package keeps no items; its tracking lives in Company OS"
    }
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@typescript/typescript6": "6.0.2",
    "chrome-devtools-mcp": "1.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "postcss-html": "2.0.0",
    "prettier-plugin-astro": "1.1.2",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "typescript-eslint": "8.72.1"
  },
  "prettier": "./config/prettier.js",
  "overrides": {
    "minimatch": "11.0.5"
  }
}
