{
  "name": "@hackersandwizards/scaffolding",
  "version": "5.39.0",
  "description": "Repository skeleton, gate commands, shared configs and the catalog shell: scaffold, scaffolding check, check-structure, check-confidential, check-staged, check-lock, chrome-mcp, raise-pins, and the catalog preset.",
  "keywords": [
    "astro-component"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "scaffold": "bin/scaffold.ts",
    "check-structure": "bin/check-structure.ts",
    "check-confidential": "bin/check-confidential.ts",
    "check-staged": "bin/check-staged.ts",
    "check-lock": "template/.githooks/check-lock.ts",
    "chrome-mcp": "bin/chrome-mcp.ts",
    "scaffolding": "bin/scaffolding.ts",
    "scaffolding-mutation": "bin/scaffolding-mutation.ts",
    "scaffolding-explore": "bin/scaffolding-explore.ts",
    "raise-pins": "bin/raise-pins.ts",
    "with-server": "bin/with-server.ts",
    "check-links": "bin/check-links.ts"
  },
  "exports": {
    "./eslint": "./config/eslint.js",
    "./eslint/astro": "./config/eslint-astro.js",
    "./tsconfig/bun.json": "./config/tsconfig.bun.json",
    "./tsconfig/astro.json": "./config/tsconfig.astro.json",
    "./prettier": "./config/prettier.js",
    "./chrome": "./lib/chrome.ts",
    "./serve": "./lib/serve.ts",
    "./rejection": "./lib/rejection.ts",
    "./catalog": "./catalog/index.ts",
    "./catalog/*": "./catalog/*",
    "./stylelint": "./config/stylelint.js",
    "./vitest": "./config/vitest.js",
    "./property": "./config/property.js",
    "./stryker": "./config/stryker.js",
    "./oxlint": "./config/oxlint.json"
  },
  "files": [
    "bin",
    "lib",
    "template",
    "template-catalog",
    "skeleton.json",
    "config",
    "catalog",
    "docs/commands.md",
    "docs/gate.md",
    "docs/configs.md",
    "docs/catalog.md",
    "docs/confidential.md",
    "docs/hooks.md"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "npm": "please-use-bun"
  },
  "packageManager": "bun@1.4.5",
  "peerDependencies": {
    "typescript": ">=5 <6.1",
    "eslint": ">=10",
    "prettier": ">=3",
    "eslint-plugin-astro": ">=1",
    "astro": ">=7",
    "astrobook": ">=0.13",
    "stylelint": ">=16"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "astrobook": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "check": "bun --no-env-file bin/scaffolding.ts check",
    "test": "bun --bun vitest run",
    "mutation": "SCAFFOLDING_MUTATION_BUN=1 bun --no-env-file bin/scaffolding-mutation.ts",
    "scaffolding-explore": "bun --no-env-file bin/scaffolding-explore.ts",
    "check:staged": "bun --no-env-file bin/check-staged.ts",
    "fix": "bun --no-env-file bin/scaffolding.ts fix",
    "check-confidential": "bun --no-env-file bin/check-confidential.ts",
    "check-lock": "bun --no-env-file template/.githooks/check-lock.ts",
    "chrome-mcp": "bun --no-env-file bin/chrome-mcp.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "astro": "7.4.13",
    "astrobook": "0.13.3",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "scaffolding": {
    "allow": [
      {
        "check": "coupling",
        "path": "skeleton.json",
        "reason": "its one relative path is the .agents/skills symlink target, resolved from .agents/, inside the repository"
      },
      {
        "check": "structure",
        "path": ".github/workflows/pages.yml",
        "reason": "here it is the reusable workflow that the owned caller file of every other repository names"
      },
      {
        "check": "coupling",
        "path": "test/checks.test.ts",
        "reason": "planted cases the coupling tests feed to the check"
      }
    ],
    "check": [],
    "typecheck": "tsc --noEmit",
    "test": "test",
    "skip": {
      "catalog": "no surface: the package ships the catalog shell and has no catalog of its own",
      "styles": "brand is not installed here, so its token file is not there to read; the shell's CSS reads brand's names by rule",
      "admin": "the package keeps no items; its tracking lives in Company OS"
    }
  },
  "dependencies": {
    "@astrojs/astro2tsx": "0.1.4",
    "@astrojs/compiler-rs": "0.5.3",
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@stryker-mutator/api": "10.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@volar/language-core": "2.4.31",
    "@volar/typescript": "2.4.31",
    "chrome-devtools-mcp": "1.13.0",
    "dependency-cruiser": "18.8.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "markdownlint-cli2": "0.24.2",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "postcss-html": "2.0.1",
    "prettier-plugin-astro": "1.1.2",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  },
  "prettier": "./config/prettier.js",
  "overrides": {
    "minimatch": "11.0.9",
    "qs": "6.17.1"
  },
  "admin": {
    "label": "Scaffolding"
  }
}
