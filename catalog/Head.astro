---
// The bar sits in a <template>, which <head> allows, and the script moves it into <main> as the
// parser creates that.
import modules from "virtual:astrobook/story-modules.mjs";
import config from "virtual:astrobook/global-config.mjs";
import RepositoryHead from "virtual:scaffolding/catalog-head";
import shell from "virtual:scaffolding/catalog";

const FOLD = 12;
type Story = { id: string; name: string };
type StoryModule = { name: string; directory?: string; stories: Story[] };
const slash = config.trailingSlash === "always" ? "/" : "";
const trim = (s: string) => s.replace(/\/$/, "");
const path = trim(decodeURI(Astro.url.pathname));
const base = trim(config.dashboardBase);
const id = path.startsWith(`${base}/`) ? path.slice(base.length + 1) : "";
const mod = id
  ? (modules as StoryModule[]).find((m) => m.stories.some((s) => s.id === id))
  : undefined;
const folder = (mod?.directory || "Components").split("/").join(" / ");
// A camelCase state reads in sentence case, "PrimaryOnNight" as "Primary on night", an acronym, a
// plural one ("PDFs") and a name with inner capitals from the list ("GitHub") whole. A name with
// underscores keeps each word in its author's case, "Angebot_ohne_Preise" as "Angebot ohne Preise".
// Either way the first word is capitalised.
const WORD =
  /(?:GitHub|GitLab|LinkedIn|YouTube|JavaScript|TypeScript|OpenAI)(?!\p{Ll})|\p{Lu}{2,}s(?!\p{Ll})|\p{Lu}+(?!\p{Ll})|\p{Lu}?\p{Ll}+|\p{N}+/gu;
const all = (mod?.stories ?? []).map((s) => {
  const [first, ...rest] = s.name.match(WORD) ?? [s.name];
  const words = [first[0].toUpperCase() + first.slice(1), ...rest];
  const sentence = !s.name.includes("_");
  const label = words
    .map((w, i) => (i && sentence && /^\p{Lu}?\p{Ll}+$/u.test(w) ? w.toLowerCase() : w))
    .join(" ");
  return { ...s, words, label };
});
type State = (typeof all)[number];
// Above FOLD states a menu groups them by a word three or more names share, the first word before
// the last: "BlockImage" under "Block", "AccentTheme" under "Theme"; the rest come last.
const menu = all.length > FOLD;
const tally = new Map<string, number>();
for (const w of all.flatMap((s) =>
  s.words.length > 1 ? [...new Set([s.words[0], s.words.at(-1)!])] : [],
))
  tally.set(w, (tally.get(w) ?? 0) + 1);
const groups = new Map<string, State[]>();
const rest: State[] = [];
for (const s of all) {
  const key = s.words.length > 1 && [s.words[0], s.words.at(-1)!].find((w) => tally.get(w)! >= 3);
  if (!key) rest.push(s);
  else groups.set(key, [...(groups.get(key) ?? []), s]);
}
const states = menu ? [...[...groups.values()].flat(), ...rest] : all;
const at = states.findIndex((s) => s.id === id);
const href = (s: Story) => `${base}/${s.id}${slash}`;
const [prev, next] = [states[at - 1], states[at + 1]];
const alone = path.startsWith(`${trim(config.storyBase)}/`);
// brand's scale and night on <html>, set before the body draws: the home at the dense scale, a
// page drawing a story at `storyScale`; night.css turns only a subtree marked data-hw-night under the
// theme toggle's data-theme, which is every page but a state alone, so a tile's preview keeps the
// state's own theme.
const root = {
  hwScale: mod || alone ? shell.storyScale : "dense",
  hwNight: alone ? undefined : "",
};
---

<meta name="robots" content="noindex" />
<meta name="description" content={shell.lead} />
<RepositoryHead />
<script
  is:inline
  set:html={`Object.assign(document.documentElement.dataset,${JSON.stringify(root)});`}
/>
<style is:global>
  #astrobook-sidebar,
  astrobook-sidebar-resize-handle {
    display: none !important;
  }
  /* A story that is a whole page may style a bare <main>, the bar's parent, as a centred grid. */
  .hw-catalogue-bar {
    display: flex;
    flex-wrap: wrap;
    justify-self: stretch;
    align-self: start;
    box-sizing: border-box;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    font: 500 0.875rem/1.4 var(--font-sans, system-ui, sans-serif);
  }
  .hw-catalogue-bar :is(a, button, select) {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    color: inherit;
    font: inherit;
    text-decoration: none;
  }
  .hw-catalogue-bar-where {
    opacity: 0.75;
  }
  .hw-catalogue-bar-tools {
    display: flex;
    gap: 0.5rem 1rem;
    margin-inline-start: auto;
  }
  /* brand's shapes: a worded button the brand corner, a field the small corner, an arrow alone
     round. */
  .hw-catalogue-bar :is(button, select, .hw-catalogue-step) {
    padding: 0 0.625rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: var(--hw-card-corner, var(--radius-brand));
    background: transparent;
    cursor: pointer;
  }
  .hw-catalogue-bar select[data-hw-states] {
    border-radius: var(--hw-corner-sm, var(--radius-sm));
  }
  .hw-catalogue-bar .hw-catalogue-step {
    box-sizing: border-box;
    justify-content: center;
    min-width: 1.75rem;
    padding: 0;
    border-radius: var(--radius-pill, 999px);
  }
  .hw-catalogue-bar button[aria-pressed="true"] {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }
  .hw-catalogue-bar .hw-catalogue-step:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .hw-catalogue-states {
    display: flex;
    flex-basis: 100%;
    align-items: center;
    gap: 0.5rem;
  }
  .hw-catalogue-states select {
    flex: 0 1 20rem;
    min-width: 0;
  }
  .hw-catalogue-states ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hw-catalogue-states li a {
    padding: 0 0.625rem;
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    border-radius: var(--radius-pill, 999px);
  }
  .hw-catalogue-states li a[aria-current] {
    border-color: currentColor;
    background: color-mix(in srgb, currentColor 12%, transparent);
    font-weight: 700;
  }
  /* The position at the bar's size, not smaller. */
  .hw-catalogue-states small {
    font-size: inherit;
    opacity: 0.75;
    white-space: nowrap;
  }
  @media (max-width: 47.99rem) {
    .hw-catalogue-keys {
      display: none;
    }
  }
</style>
{mod && (
  <template id="hw-catalogue-bar">
    <nav class="hw-catalogue-bar" aria-label="Catalog">
      <a href={`${trim(config.astrobookBase)}/`}>
        <span aria-hidden="true">←&nbsp;</span>Catalog
      </a>
      <span class="hw-catalogue-bar-where">
        {folder} / <strong>{mod.name}</strong>
      </span>
      <span class="hw-catalogue-bar-tools">
        <button type="button" data-hw-theme aria-pressed="false">
          Dark theme
        </button>
        <a href={`${trim(config.storyBase)}/${id}${slash}`}>Open this state alone</a>
      </span>
      {states.length > 1 && (
        <div class="hw-catalogue-states">
          {prev ? (
            <a class="hw-catalogue-step" rel="prev" href={href(prev)} aria-label="Previous state">
              ‹
            </a>
          ) : (
            <button class="hw-catalogue-step" type="button" disabled aria-label="Previous state">
              ‹
            </button>
          )}
          {menu ? (
            <select data-hw-states aria-label="State">
              {[...groups, ["", rest] as const].map(([group, list]) => {
                const options = list.map((s) => (
                  <option value={href(s)} selected={s.id === id}>
                    {s.label}
                  </option>
                ));
                return group ? <optgroup label={group}>{options}</optgroup> : options;
              })}
            </select>
          ) : (
            <ul aria-label="States">
              {states.map((s) => (
                <li>
                  <a href={href(s)} aria-current={s.id === id ? "page" : undefined}>
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {next ? (
            <a class="hw-catalogue-step" rel="next" href={href(next)} aria-label="Next state">
              ›
            </a>
          ) : (
            <button class="hw-catalogue-step" type="button" disabled aria-label="Next state">
              ›
            </button>
          )}
          <small>
            {at + 1} of {states.length}
            <span class="hw-catalogue-keys"> · ← → to step</span>
          </small>
        </div>
      )}
    </nav>
  </template>
)}
<script is:inline>
  // A module script runs after the parse, by which time a page can have painted, and the bar then
  // pushes the story down by its own height: a layout shift. An observer's callback runs before
  // the next paint. The listeners sit here too, so a bar on screen already answers.
  (() => {
    const theme = () => window.astroThemeToggle;
    const pressed = () =>
      document
        .querySelector("[data-hw-theme]")
        ?.setAttribute("aria-pressed", String(theme()?.getTheme?.() === "dark"));
    const bar = document.getElementById("hw-catalogue-bar");
    if (bar)
      new MutationObserver((_, observer) => {
        const main = document.querySelector("main");
        if (!main) return;
        observer.disconnect();
        main.prepend(bar.content.cloneNode(true));
        pressed();
      }).observe(document, { childList: true, subtree: true });
    document.addEventListener("click", (event) => {
      if (!event.target.closest?.("[data-hw-theme]")) return;
      theme()?.setTheme?.(theme().getTheme?.() === "dark" ? "light" : "dark");
      pressed();
    });
    document.addEventListener("change", (event) => {
      if (event.target.matches?.("[data-hw-states]")) location.href = event.target.value;
    });
    // The arrow keys step through the states unless a field or the story has the focus.
    document.addEventListener("keydown", (event) => {
      if (
        event.defaultPrevented ||
        event.altKey ||
        event.ctrlKey ||
        event.metaKey ||
        event.shiftKey
      )
        return;
      const on = event.target.closest?.bind(event.target);
      if (
        on?.("input, select, textarea, [contenteditable]") ||
        (on?.("main") && !on(".hw-catalogue-bar"))
      )
        return;
      const rel = { ArrowLeft: "prev", ArrowRight: "next" }[event.key];
      const link = rel && document.querySelector(`.hw-catalogue-bar a[rel="${rel}"]`);
      if (link) location.href = link.href;
    });
  })();
</script>
<script is:inline type="module">
  // Astrobook's client router swaps pages without loading them, which drops every attribute the
  // head sets on <html> (data-hw-scale, hw-focus-ring) and leaves its page scripts
  // unrun. Without this marker the router loads each page in full. A module script runs once the
  // document is parsed, so the marker exists, and before the router's own module, which follows.
  document.querySelector('meta[name="astro-view-transitions-enabled"]')?.remove();
</script>
