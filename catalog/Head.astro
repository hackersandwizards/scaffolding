---
// The bar sits in a <template>, which <head> allows, and the script moves it into <main> as the
// parser creates that; the header, where the preset has a `nav`, goes before <main>.
import modules from "virtual:astrobook/story-modules.mjs";
import config from "virtual:astrobook/global-config.mjs";
import RepositoryHead from "virtual:scaffolding/catalog-head";
import around from "virtual:scaffolding/catalog-around";
import icon from "virtual:scaffolding/catalog-icon";
import shell from "virtual:scaffolding/catalog";
import Top from "./Top.astro";
import { label, wordsOf } from "./words.ts";

const FOLD = 12;
type Story = { id: string; name: string };
type StoryModule = { name: string; directory?: string; stories: Story[] };
const trim = (s: string) => s.replace(/\/$/, "");
const path = trim(decodeURI(Astro.url.pathname));
const base = trim(config.dashboardBase);
const id = path.startsWith(`${base}/`) ? path.slice(base.length + 1) : "";
const mod = id
  ? (modules as StoryModule[]).find((m) => m.stories.some((s) => s.id === id))
  : undefined;
const folder = (mod?.directory || "Components").split("/").join(" / ");
const all = (mod?.stories ?? []).map((s) => {
  const words = wordsOf(s.name);
  return { ...s, words, label: label(s.name, words) };
});
type State = (typeof all)[number];
// Above FOLD states a menu groups them by a word three or more names share, the first word before
// the last: "BlockImage" under "Block", "AccentTheme" under "Theme"; the rest come last.
const menu = all.length > FOLD;
const edgeWords = (words: string[]): string[] => {
  const first = words[0];
  const last = words.at(-1);
  return words.length > 1 && first !== undefined && last !== undefined
    ? [...new Set([first, last])]
    : [];
};
const tally = new Map<string, number>();
for (const w of all.flatMap((s) => edgeWords(s.words))) tally.set(w, (tally.get(w) ?? 0) + 1);
const groups = new Map<string, State[]>();
const rest: State[] = [];
for (const s of all) {
  const key = edgeWords(s.words).find((w) => (tally.get(w) ?? 0) >= 3);
  if (!key) rest.push(s);
  else groups.set(key, [...(groups.get(key) ?? []), s]);
}
const states = menu ? [...[...groups.values()].flat(), ...rest] : all;
const at = states.findIndex((s) => s.id === id);
const href = (s: Story) => `${base}/${s.id}${shell.slash}`;
const [prev, next] = [states[at - 1], states[at + 1]];
const storyBase = trim(config.storyBase);
const alone = path.startsWith(`${storyBase}/`);
// A state alone is the frame a tile draws, so the state's page is the one a reader lands on. An
// absolute URL needs Astro's `site`.
const url = trim(Astro.url.pathname);
const page =
  `${alone ? url.replace(encodeURI(storyBase), encodeURI(base)) : url}${shell.slash}` || "/";
const canonical = Astro.site ? new URL(page, Astro.site).href : page;
const { hwCatalogLead: lead } = Astro.locals as { hwCatalogLead?: unknown };
// brand's scale and night on <html>, set before the body draws: the home at the dense scale, a
// page drawing a story at `storyScale`; night.css turns only a subtree marked data-hw-night under the
// theme toggle's data-theme, which is every page but a state alone, so a tile's preview keeps the
// state's own theme, and no page where `themeToggle` is false. A page without it draws in the day
// theme: Astrobook's theme script turned it dark from the stored choice or the system's, and brand's
// elements followed while its ground stayed light. The choice stays stored for the other pages.
const root = {
  hwScale: mod || alone ? shell.storyScale : "dense",
  hwNight: alone || !shell.themeToggle ? undefined : "",
};
---

<style is:inline set:html={shell.layers} />
{!alone && <style is:inline set:html={around} />}
<meta name="description" content={typeof lead === "string" && lead.trim() ? lead : shell.lead} />
{!shell.onDisk && <link rel="canonical" href={canonical} />}
{/* Ahead of the repository's head: of two icons a browser takes the last. */}
{icon && <link rel="icon" href={icon} type="image/svg+xml" />}
<RepositoryHead />
<script
  is:inline
  set:html={`Object.assign(document.documentElement.dataset,${JSON.stringify(root)});${root.hwNight === undefined ? 'document.documentElement.dataset.theme="light";document.documentElement.classList.remove("dark");document.documentElement.style.colorScheme="light";' : ""}document.documentElement.classList.add(...${JSON.stringify(shell.htmlClass)});${alone ? 'if(window===top)document.documentElement.dataset.hwAlone="";' : ""}`}
/>
{mod && (
  <template id="hw-catalog-bar">
    {shell.nav && (
      <div data-hw-catalog-top>
        <Top current="true" />
      </div>
    )}
    <nav class="hw-catalog-bar" aria-label="Catalog">
      <a href={shell.link}>
        <span aria-hidden="true">←&nbsp;</span>Catalog
      </a>
      <span class="hw-catalog-bar-where">
        {folder} / <strong>{label(mod.name)}</strong>
      </span>
      <span class="hw-catalog-bar-tools">
        {shell.themeToggle && !shell.headerToggle && (
          <button type="button" data-hw-theme aria-pressed="false">
            Dark theme
          </button>
        )}
        <a class="hw-catalog-tool" href={`${storyBase}/${id}${shell.slash}`}>
          Open this state alone
        </a>
      </span>
      {states.length > 1 && (
        <div class="hw-catalog-states">
          {prev ? (
            <a class="hw-catalog-step" rel="prev" href={href(prev)} aria-label="Previous state">
              ‹
            </a>
          ) : (
            <button class="hw-catalog-step" type="button" disabled aria-label="Previous state">
              ‹
            </button>
          )}
          {menu ? (
            <select data-hw-states aria-label="State">
              {[...groups, ["", rest] as const].map(([group, list]) => {
                const options = list.map((s) => (
                  <option value={href(s)} selected={s.id === id}>
                    {s.label}
                  </option>
                ));
                return group ? <optgroup label={group}>{options}</optgroup> : options;
              })}
            </select>
          ) : (
            <ul aria-label="States">
              {states.map((s) => (
                <li>
                  <a href={href(s)} aria-current={s.id === id ? "page" : undefined}>
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {next ? (
            <a class="hw-catalog-step" rel="next" href={href(next)} aria-label="Next state">
              ›
            </a>
          ) : (
            <button class="hw-catalog-step" type="button" disabled aria-label="Next state">
              ›
            </button>
          )}
          <small>
            {at + 1} of {states.length}
            <span class="hw-catalog-keys"> · ← → to step</span>
          </small>
        </div>
      )}
    </nav>
  </template>
)}
<script is:inline>
  // A module script runs after the parse, by which time a page can have painted, and the bar then
  // pushes the story down by its own height: a layout shift. An observer's callback runs before
  // the next paint. The listeners sit here too, so a bar on screen already answers.
  (() => {
    const theme = () => window.astroThemeToggle;
    // brand's ThemeToggle keeps the reader's choice under "theme", Astrobook's toggle under its
    // own key: the bar takes brand's and writes both, so one choice holds on the repository's pages
    // and in its catalog. Storage may be blocked (a file:// page); the choice then holds here only.
    const BRAND_KEY = "theme";
    const savedTheme = () => {
      try {
        return localStorage.getItem(BRAND_KEY);
      } catch (error) {
        if (error instanceof DOMException && error.name === "SecurityError") return null;
        throw error;
      }
    };
    const saveTheme = (chosen) => {
      const value = String(chosen);
      try {
        localStorage.setItem(BRAND_KEY, value);
      } catch (error) {
        if (
          error instanceof DOMException &&
          (error.name === "SecurityError" || error.name === "QuotaExceededError")
        )
          return;
        throw error;
      }
    };
    if (document.documentElement.dataset.hwNight !== undefined) {
      const chosen = savedTheme();
      if ((chosen === "dark" || chosen === "light") && theme()?.getTheme() !== chosen)
        theme()?.setTheme(chosen);
    }
    const pressed = () =>
      document
        .querySelector("[data-hw-theme]")
        ?.setAttribute("aria-pressed", String(theme()?.getTheme() === "dark"));
    // brand's switch in the header flips data-theme and stores the choice; Astrobook's toggle
    // follows, and a flip by Astrobook's is stored, on a page that turns at all: a state alone, a
    // tile's frame included, keeps its day theme and leaves the stored choice alone.
    const root = document.documentElement;
    if (root.dataset.hwNight !== undefined)
      new MutationObserver(() => {
        const chosen = root.dataset.theme;
        if (chosen !== "dark" && chosen !== "light") return;
        if (theme()?.getTheme() !== chosen) theme()?.setTheme(chosen);
        saveTheme(chosen);
        pressed();
      }).observe(root, { attributeFilter: ["data-theme"] });
    const bar = document.getElementById("hw-catalog-bar");
    if (bar instanceof HTMLTemplateElement) {
      // The preload scanner skips the template, so the header's logo is otherwise asked for only
      // once the parser reaches <main>: on a slow connection, with the rest of the document, 30 to
      // 57 ms later on DevTools' 3G and no longer ahead of the stylesheets' requests.
      bar.content.querySelectorAll('img[src]:not([loading="lazy"])').forEach((img) => {
        const src = img.getAttribute("src");
        if (src !== null) new Image().src = src;
      });
      new MutationObserver((_, observer) => {
        const main = document.querySelector("main");
        if (!main) return;
        observer.disconnect();
        const parts = bar.content.cloneNode(true);
        if (!(parts instanceof DocumentFragment)) return;
        const top = parts.querySelector("[data-hw-catalog-top]");
        if (top) main.before(top);
        main.prepend(parts);
        pressed();
      }).observe(document, { childList: true, subtree: true });
    }
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element && event.target.closest("[data-hw-theme]"))) return;
      const toggle = theme();
      if (toggle) {
        toggle.setTheme(toggle.getTheme() === "dark" ? "light" : "dark");
        saveTheme(toggle.getTheme());
      }
      pressed();
    });
    document.addEventListener("change", (event) => {
      if (event.target instanceof HTMLSelectElement && event.target.matches("[data-hw-states]"))
        location.href = event.target.value;
    });
    const stateDirections = new Map([
      ["ArrowLeft", "prev"],
      ["ArrowRight", "next"],
    ]);
    /** @param {KeyboardEvent} event */
    function followCatalogStateLink(event) {
      const rel = stateDirections.get(event.key);
      if (rel === undefined) return;
      const link = document.querySelector(`.hw-catalog-bar a[rel="${rel}"]`);
      if (link instanceof HTMLAnchorElement)
        setTimeout(() => {
          if (!event.defaultPrevented) location.href = link.href;
        });
    }
    // The arrow keys step through the states unless a field or the story has the focus, or a
    // story's own handler, which runs after this one, takes the key.
    document.addEventListener("keydown", (event) => {
      if (
        event.defaultPrevented ||
        event.altKey ||
        event.ctrlKey ||
        event.metaKey ||
        event.shiftKey
      )
        return;
      const target = event.target;
      if (
        target instanceof Element &&
        (target.closest("input, select, textarea, [contenteditable]") ||
          (target.closest("main") && !target.closest(".hw-catalog-bar")))
      )
        return;
      followCatalogStateLink(event);
    });
  })();
</script>
<script is:inline type="module">
  // Astrobook's client router swaps pages without loading them, which drops every attribute the
  // head sets on <html> (data-hw-scale, hw-focus-ring) and leaves its page scripts
  // unrun. Without this marker the router loads each page in full. A module script runs once the
  // document is parsed, so the marker exists, and before the router's own module, which follows.
  document.querySelector('meta[name="astro-view-transitions-enabled"]')?.remove();
</script>
