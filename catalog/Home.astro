---
import modules from "virtual:astrobook/story-modules.mjs";
import config from "virtual:astrobook/global-config.mjs";
import options from "virtual:scaffolding/catalog";
import Layout from "./Layout.astro";

type StoryModule = { name: string; directory?: string; stories: { id: string }[] };

interface Props {
  product?: string;
  href?: string;
  title?: string;
  lead?: string;
  previews?: boolean;
  previewSize?: [number, number];
  groupOrder?: string[];
  previewStates?: string[];
}

const {
  product,
  href,
  title,
  lead,
  previews = true,
  previewSize,
  groupOrder = [],
  previewStates = [],
} = { ...options, ...Astro.props };
const rank = (g: string) => (groupOrder.includes(g) ? groupOrder.indexOf(g) : groupOrder.length);
const slash = config.trailingSlash === "always" ? "/" : "";
const url = (base: string, id: string) => `${base.replace(/\/$/, "")}/${id}${slash}`;
const groups = new Map<
  string,
  { name: string; href: string; pill: string; frame?: string; frameSize?: [number, number] }[]
>();
let states = 0;
for (const m of [...(modules as StoryModule[])].sort((a, b) => a.name.localeCompare(b.name))) {
  const first =
    previewStates
      .map((state) => m.stories.find((s) => s.id.endsWith(`/${state}`)))
      .find((s) => s !== undefined) ?? m.stories[0];
  if (!first) continue;
  states += m.stories.length;
  const group = m.directory?.split("/")[0] || "Components";
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({
    name: m.name,
    href: url(config.dashboardBase, first.id),
    pill: m.stories.length === 1 ? "1 state" : `${m.stories.length} states`,
    frame: previews ? url(config.storyBase, first.id) : undefined,
    frameSize: previewSize,
  });
}
const data = {
  title,
  lead,
  provenance: `${options.provenance} · ${modules.length} components · ${states} states`,
  groups: [...groups]
    .sort(([a], [b]) => rank(a) - rank(b) || a.localeCompare(b))
    .map(([name, items]) => ({ name, items })),
};
---

<Layout product={product} href={href} {...data}>
  <slot name="nav" slot="nav" />
  <slot />
</Layout>
