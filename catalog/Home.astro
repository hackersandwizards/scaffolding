---
import modules from "virtual:astrobook/story-modules.mjs";
import config from "virtual:astrobook/global-config.mjs";
import options from "virtual:scaffolding/catalog";
import Layout from "./Layout.astro";
import { label } from "./words.ts";
import type { CatalogOptions } from "./index.ts";

type StoryModule = { name: string; directory?: string; stories: { id: string }[] };

interface Props {
  product?: string;
  href?: string;
  admin?: string;
  title?: string;
  lead?: string;
  previews?: CatalogOptions["previews"];
  previewSize?: CatalogOptions["previewSize"];
  groupOrder?: string[];
  previewStates?: string[];
}

const {
  product,
  href,
  admin,
  title,
  lead,
  previews = true,
  previewSize,
  groupOrder = [],
  previewStates = [],
} = { ...options, ...Astro.props };
const rank = (g: string) => (groupOrder.includes(g) ? groupOrder.indexOf(g) : groupOrder.length);
const url = (base: string, id: string) => `${base.replace(/\/$/, "")}/${id}${options.slash}`;
const groups = new Map<
  string,
  {
    name: string;
    href: string;
    pill: string;
    frame?: string;
    frameSrcdoc?: boolean;
    frameSize?: [number, number];
  }[]
>();
let states = 0;
const named = (modules as StoryModule[]).map((m) => ({ ...m, label: label(m.name) }));
for (const m of named.sort((a, b) => a.label.localeCompare(b.label))) {
  const first =
    previewStates
      .map((state) => m.stories.find((s) => s.id.endsWith(`/${state}`)))
      .find((s) => s !== undefined) ?? m.stories[0];
  if (!first) continue;
  states += m.stories.length;
  const group = m.directory?.split("/")[0] || "Components";
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push({
    name: m.label,
    search: m.name,
    href: url(config.dashboardBase, first.id),
    pill: m.stories.length === 1 ? "1 state" : `${m.stories.length} states`,
    frame: previews ? url(config.storyBase, first.id) : undefined,
    frameSrcdoc: previews === "srcdoc",
    frameSize: Array.isArray(previewSize)
      ? previewSize
      : previewSize && Object.hasOwn(previewSize, group)
        ? previewSize[group]
        : undefined,
  });
}
// A renamed group would otherwise draw its tiles at the small fitted size unseen.
if (previewSize && !Array.isArray(previewSize))
  for (const key of Object.keys(previewSize))
    if (!groups.has(key))
      throw new Error(
        `catalog previewSize: "${key}" names no story group (${[...groups.keys()].sort().join(", ")})`,
      );
const data = {
  title,
  lead,
  provenance: `${options.provenance} · ${modules.length} components · ${states} states`,
  groups: [...groups]
    .sort(([a], [b]) => rank(a) - rank(b) || a.localeCompare(b))
    .map(([name, items]) => ({ name, items })),
};
---

<Layout product={product} href={href} admin={admin} {...data}>
  <slot name="nav" slot="nav" />
  <slot />
</Layout>
