#!/bin/sh
# bun install --frozen-lockfile under the lock the gate and a build hold (node_modules/.check.lock),
# for the post-merge and post-checkout hooks, the SessionStart hook and the MCP server's start.
# Silent when it installs; a skip or a failure goes to stderr with what to run. Never to stdout,
# which is an MCP server's protocol channel.
cd "$(git rev-parse --show-toplevel)" || exit 1
lock=node_modules/.check.lock
log=$(mktemp) || exit 1
trap 'rm -f "$log"' EXIT
if [ -x node_modules/.bin/check-lock ] || grep -q '"check-lock":' package.json 2>/dev/null; then
  # Without waiting behind a gate or a build, which a merge or a session start would otherwise do
  # for minutes: a gate installs as its first step; after a build, the next gate or session start
  # installs. Another install holding the lock is waited for, as check-lock does for its own command.
  CHECK_LOCK_WAIT_MS=0 bun run --silent check-lock bun install --frozen-lockfile </dev/null >"$log" 2>&1
else
  # No check-lock before the first install: the lock is taken by check-lock's rules, so another
  # first install, or check-lock once linked, waits for this one. A lock is live while its pid or
  # its group (here bun's pid, which outlives a killed shell) runs; one that names neither is stale.
  field() { printf %s "$2" | sed -n "s/.*\"$1\":\([1-9][0-9]*\).*/\1/p"; }
  live() { kill -0 "$(field pid "$1")" 2>/dev/null || kill -0 "$(field group "$1")" 2>/dev/null; }
  # A stale lock is removed under a numbered claim for exactly its contents, which no other waiter
  # can take while they stand: a dead claimant is passed over, a live one ends the try.
  reclaim() {
    raw=$(cat "$lock" 2>/dev/null) || return 0
    live "$raw" && return 0
    base="$lock.reclaim-$(printf %s "$raw" | cksum | cut -d ' ' -f 1)"
    slot=0
    until ln "$lock.$$" "$base.$slot" 2>/dev/null; do
      owner=$(cat "$base.$slot" 2>/dev/null) || return 0
      live "$owner" && return 0
      slot=$((slot + 1))
    done
    [ "$(cat "$lock" 2>/dev/null)" = "$raw" ] && rm -f "$lock"
    while [ "$slot" -ge 0 ]; do
      rm -f "$base.$slot"
      slot=$((slot - 1))
    done
  }
  holds() { [ "$(field pid "$(cat "$lock" 2>/dev/null)")" = $$ ]; }
  # The lock goes only while it names this shell and bun has ended.
  trap 'rm -f "$log" "$lock.$$"; holds && ! kill -0 "$bun" 2>/dev/null && rm -f "$lock"' EXIT
  mkdir -p node_modules
  entry() {
    printf '{"pid":%s,"startedAt":%s000,"command":["bun","install","--frozen-lockfile"]%s}' \
      $$ "$started" "$1" >"$lock.$$"
  }
  started=$(date +%s)
  entry ""
  waited=0
  until ln "$lock.$$" "$lock" 2>/dev/null; do
    reclaim
    ln "$lock.$$" "$lock" 2>/dev/null && break
    [ "$waited" -lt 300 ] || break
    sleep 1
    waited=$((waited + 1))
  done
  # A link to the lock itself once taken: entry() must write a new file, never through it.
  rm -f "$lock.$$"
  if holds; then
    bun install --frozen-lockfile </dev/null >"$log" 2>&1 &
    bun=$!
    entry ",\"group\":$bun" && mv "$lock.$$" "$lock"
    wait "$bun"
  else
    echo "[install] pid $(field pid "$(cat "$lock" 2>/dev/null)") still holds $lock after 300 s; not installing beside it" >"$log"
    false
  fi
fi
status=$?
if [ "$status" -ne 0 ]; then
  cat "$log" >&2
  echo "[install] bun install --frozen-lockfile did not run or failed (above): run it before your gate" >&2
fi
exit "$status"
