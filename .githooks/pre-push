#!/bin/sh
export SCAFFOLDING_GIT_HOOK=1
# check-confidential prepush refuses commits purged from history (.confidential-purged.json),
# then hands the refs to Git LFS where the push may carry LFS objects or touch a lockable file.
# A branch push runs the full gate for a deploy destination, or the changed gate over its ranges.
# See docs/gate.md in scaffolding.
[ -d node_modules ] || { echo "$(basename "$0"): no node_modules in this checkout: run bun install, then try again" >&2; exit 1; }
refs=$(cat)
{ [ -z "$refs" ] || printf '%s\n' "$refs"; } | bun run --silent check-confidential prepush "$@" || exit
# Git writes the source expression verbatim, including spaces in a reflog date.
updates=$(printf '%s\n' "$refs" | awk 'NF >= 4 && $(NF-1) ~ /^refs\/heads\// && $(NF-2) !~ /^0+$/ { print substr($(NF-1), 12), $NF ".." $(NF-2) }')
[ -n "$updates" ] || exit 0
deploy=$(printf '%s\n' "$updates" | bun --no-env-file -e '
  const { scaffolding } = await Bun.file("package.json").json();
  const deploy = scaffolding?.deploy;
  const branches = (await Bun.stdin.text()).trimEnd().split("\n");
  if (Array.isArray(deploy) && branches.some((line) => deploy.includes(line.split(" ", 1)[0])))
    console.log("yes");
') || exit
# git hands a hook in a linked worktree GIT_DIR, which every git the gate's tests run in a repository
# of their own would then write into: the gate finds the checkout from its directory instead.
local_env_vars=$(git rev-parse --local-env-vars)
while IFS= read -r var; do
  [ -z "$var" ] || unset "$var"
done <<EOF
$local_env_vars
EOF
if [ "$deploy" = yes ]; then
  exec bun run --silent check
fi
set --
while IFS=' ' read -r _branch range; do
  set -- "$@" "$range"
done <<EOF
$updates
EOF
exec bun run --silent check --changed "$@"
